# ── Base de datos ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=4000
DB_NAME=mastrflow
DB_USER=mastrflow
DB_PASS=mastrflow_pass

# ── Servidor ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_en_produccion_usa_una_clave_larga
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:1420

# ── Docker MySQL ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_USER=mastrflow
MYSQL_PASSWORD=mastrflow_pass
